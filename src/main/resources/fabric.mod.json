{
  "schemaVersion": 1,
  "id": "tw-core",
  "version": "${version}",
  "name": "TW`s Core",
  "description": "Tenacious Wonder ",
  "authors": ["The bridge between Tenacious Wonder mods"],
  "contact": {
    "homepage": "https://modrinth.com/mod/tw-core",
    "sources": "https://github.com/666daji/TWCore",
    "issues": "https://github.com/666daji/TWCore/issues"
  },
  "license": "MIT",
  "icon": "assets/tw_core/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "org.twcore.client.TWCoreDataGenerator"
    ],
    "client": [
      "org.twcore.client.TWCoreClient"
    ],
    "main": [
      "org.twcore.TWCore"
    ]
  },
  "mixins": [
    "tw_core.mixins.json",
    {
      "config": "tw_core.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.15.9",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
